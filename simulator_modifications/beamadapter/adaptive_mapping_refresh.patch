+template <class TIn, class TOut>
+void AdaptiveBeamMapping< TIn, TOut>::handleEvent(sofa::core::objectmodel::Event* event)
+{
+    // With nbPointsPerBeam the mapped points follow the beams, which an interventional radiology
+    // controller changes at the beginning of the step. The output is otherwise re-sampled only when the
+    // free motion is propagated, after this step's collision detection has used last step's points: a
+    // contact then names a point of the old list, which the constraint is mapped with the new list (the
+    // neighbouring node, or past the end when the count dropped). When listening, re-map right after the
+    // controller (it sits in a parent node), as MultiAdaptiveBeamMapping does. Velocity, free position
+    // and free velocity keep last step's values until the free motion recomputes them; nothing reads them
+    // before (contacts use the free positions only after the free motion).
+    if (sofa::simulation::AnimateBeginEvent::checkEventType(event) && !m_isSubMapping
+        && d_useCurvAbs.getValue() && d_nbPointsPerBeam.getValue() > 0)
+    {
+        apply(sofa::core::mechanicalparams::defaultInstance(),
+              *this->toModel->write(sofa::core::vec_id::write_access::position),
+              *this->fromModel->read(sofa::core::vec_id::read_access::position));
+    }
+}
