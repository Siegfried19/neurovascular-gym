+template <class DataTypes>
+void InterventionalRadiologyController<DataTypes>::computeDensestCurvAbs(type::vector<Real> &newCurvAbs,
+    const type::vector<Real>& tools_xBegin)
+{
+    // The same key points and the same grids as computeInstrumentsCurvAbs (each section sampled
+    // backwards from its end at its own density), but each stretch of the combined instrument takes
+    // the grid of the densest section covering it; on a tie the instrument listed first, which is
+    // what computeInstrumentsCurvAbs gives everywhere (a later instrument only beyond the others).
+    struct Section { Real begin, end, ratio; };
+    type::vector<Section> sections;
+    type::vector<Real> cuts{ Real(0) };
+    for (sofa::Size i = 0; i < m_instrumentsList.size(); i++)
+    {
+        type::vector<Real> xP_noticeable_I;
+        type::vector<sofa::Size> density_I;
+        m_instrumentsList[i]->getSamplingParameters(xP_noticeable_I, density_I);
+        if (xP_noticeable_I.empty())
+        {
+            msg_error() << "Instrument " << i << " provides no sampling parameters (no noticeable point). Skipping it.";
+            continue;
+        }
+        for (int j = 0; j < (int)(xP_noticeable_I.size() - 1); j++)
+        {
+            const Real xP = xP_noticeable_I[j];
+            const Real nxP = xP_noticeable_I[j + 1];
+            const Real curvAbs_xP = tools_xBegin[i] + xP;
+            const Real curvAbs_nxP = tools_xBegin[i] + nxP;
+            if (curvAbs_xP > 0)
+                newCurvAbs.push_back(curvAbs_xP);
+            if (curvAbs_nxP > 0)
+            {
+                const Real begin = std::max(curvAbs_xP, Real(0));
+                sections.push_back({ begin, curvAbs_nxP, Real(density_I[j]) / (nxP - xP) });
+                cuts.push_back(begin);
+                cuts.push_back(curvAbs_nxP);
+            }
+        }
+        const Real curvAbs_lastxP = tools_xBegin[i] + xP_noticeable_I[xP_noticeable_I.size() - 1];
+        if (curvAbs_lastxP > 0)
+            newCurvAbs.push_back(curvAbs_lastxP);
+    }
+
+    std::sort(cuts.begin(), cuts.end());
+    cuts.erase(std::unique(cuts.begin(), cuts.end()), cuts.end());
+    for (sofa::Size c = 0; c + 1 < cuts.size(); c++)
+    {
+        const Real from = cuts[c], to = cuts[c + 1], middle = Real(0.5) * (from + to);
+        int best = -1;
+        for (int s = 0; s < (int)sections.size(); s++)
+        {
+            const Section& section = sections[s];
+            if (section.begin <= middle && middle <= section.end
+                && (best < 0 || section.ratio > sections[best].ratio))
+                best = s;
+        }
+        if (best < 0 || sections[best].ratio <= 0)
+            continue;
+        const Section& section = sections[best];
+        // grid nodes end - k / ratio inside (from, to); "from" and "to" are key points, tips or 0
+        const int kFirst = std::max(1, int(std::ceil((section.end - to) * section.ratio)));
+        const int kLast = int(std::floor((section.end - from) * section.ratio));
+        for (int k = kLast; k >= kFirst; k--)
+        {
+            const Real value = section.end - (k / section.ratio);
+            if (value > from && value < to)
+                newCurvAbs.push_back(value);
+        }
+    }
+}
